# Copy to .env and fill in your key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Models under comparison (Section 3). Any OpenRouter slug works:
#   https://openrouter.ai/models
# Default: a frontier model vs its efficient sibling (same generation) so the
# comparison isolates capability rather than provider differences.
MODEL_A=openai/gpt-5.4
MODEL_B=openai/gpt-5.4-mini

# Independent judge for the LLM-as-judge metrics. Deliberately a DIFFERENT
# provider/family than the models under test, to avoid self-preference bias.
JUDGE_MODEL=anthropic/claude-sonnet-4.6

# Optional: shown on the OpenRouter dashboard for your requests.
OPENROUTER_APP_TITLE=Email Generation Assistant Eval
